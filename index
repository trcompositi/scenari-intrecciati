            document.getElementById('minigame-screen').style.display = 'none'; document.getElementById('cards-screen').style.display = 'flex';
            document.getElementById('playingCard').classList.remove('is-flipped'); document.getElementById('continueBtn').style.display = 'none';
            
            const roleName = roleplayScenarios[currentScenarioId].roles[selectedVictim];
            document.getElementById('card-turn-title').innerText = `Azione per ${roleName}`;
            document.getElementById('card-turn-title').style.color = selectedVictim === "Claudia" ? "var(--primary-accent)" : "var(--secondary-accent)";
            document.getElementById('cardRoleLabel').innerText = `RUOLO: ${roleName.toUpperCase()}`;
            document.getElementById('cardRoleLabel').style.color = selectedVictim === "Claudia" ? "var(--primary-accent)" : "var(--secondary-accent)";
            
            const levelData = roleplayScenarios[currentScenarioId].levels[currentLevelIndex];
            
            // Filtra le azioni basate sia sull'attore (Claudia/Tiziano) sia sulle Categorie attive
            let validActions = levelData.actions.filter(a => 
                a.actor === selectedVictim && 
                (activeCategories.includes(a.category) || !a.category)
            );
            
            // Fallback se i filtri sono troppo restrittivi
            if(validActions.length === 0) {
                validActions = levelData.actions.filter(a => a.actor === selectedVictim);
            }
            
            if(validActions.length > 0) {
                const drawn = validActions[Math.floor(Math.random() * validActions.length)];
                document.getElementById('cardText').innerText = drawn.text;
                document.getElementById('cardCategoryTag').innerText = `CATEGORIA: ${drawn.category ? drawn.category.toUpperCase() : 'GENERALE'}`;
