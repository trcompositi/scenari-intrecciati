                    return;
                }
                document.getElementById('vn-screen').style.display = 'block'; loadLevelNarrative();
            } else {
                document.getElementById('vn-screen').style.display = 'block'; document.getElementById('dialogue-box').style.display = 'none';
                document.getElementById('choices-container').innerHTML = `<button class='choice-btn' onclick='openMinigame()'>Prossima Azione 🎡 (${actionsCompletedInLevel}/${ACTIONS_PER_LEVEL})</button>`;
            }
        }
    </script>
</body>
</html>
