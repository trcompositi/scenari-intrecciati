        function spinTheWheel() {
            const wheel = document.getElementById('spinWheel');
            document.getElementById('spinBtn').style.display = 'none';
            const winnerText = document.getElementById('winner-text');
            
            const extraDegrees = Math.floor(Math.random() * 360);
            currentRotation += 1440 + extraDegrees; 
            wheel.style.transform = `rotate(${currentRotation}deg)`;

            setTimeout(() => {
                const pointerAngle = (360 - (currentRotation % 360)) % 360;
                if (pointerAngle >= 0 && pointerAngle < 180) { selectedVictim = "Tiziano"; winnerText.style.color = "var(--secondary-accent)"; } 
                else { selectedVictim = "Claudia"; winnerText.style.color = "var(--primary-accent)"; }

                winnerText.innerText = `Tocca a: ${roleplayScenarios[currentScenarioId].roles[selectedVictim]}`;
                winnerText.style.opacity = 1; document.getElementById('nextPhaseBtn').style.display = 'block';
            }, 4000);
        }

