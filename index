        window.onload = function() {
            if(LINK_SCENARI_RAW && LINK_SCENARI_RAW.startsWith("http")) {
                loadFromGoogleSheets();
            } else {
                // Caricamento dal database locale completo
                roleplayScenarios = localDatabaseScenarios;
                buildScenarioMenu();
            }
        };

        function loadFromGoogleSheets() {
            const proxy = "https://corsproxy.io/?";
            const urlScenari = proxy + encodeURIComponent(LINK_SCENARI_RAW);
            const urlCopione = proxy + encodeURIComponent(LINK_COPIONE_RAW);

            Papa.parse(urlScenari, {
                download: true, header: true, skipEmptyLines: true,
                transformHeader: h => h.trim(),
                complete: function(res) {
                    if(res.data && res.data.length > 0) {
                        roleplayScenarios = {};
                        res.data.forEach(row => {
                            if(!row.ID_Scenario) return;
                            roleplayScenarios[row.ID_Scenario] = {
                                title: row.Titolo_Storia, context: row.Contesto_Menu,
                                roles: { "Claudia": row.Ruolo_Claudia, "Tiziano": row.Ruolo_Tiziano },
                                briefing: { "Claudia": row.Briefing_Claudia, "Tiziano": row.Briefing_Tiziano },
                                levels: []
                            };
                        });
                        
                        Papa.parse(urlCopione, {
                            download: true, header: true, skipEmptyLines: true,
                            transformHeader: h => h.trim(),
                            complete: function(resCopione) {
                                resCopione.data.forEach(row => {
                                    let id = row.ID_Scenario;
                                    if(!id || !roleplayScenarios[id]) return;
                                    let lvlIndex = parseInt(row.Livello) - 1;
                                    if(isNaN(lvlIndex)) return;
                                    if(!roleplayScenarios[id].levels[lvlIndex]) {
                                        let bg = row.Sfondo_URL ? row.Sfondo_URL.trim() : "#000";
                                        roleplayScenarios[id].levels[lvlIndex] = { level: lvlIndex + 1, background: bg, introDialogues: [], actions: [] };
                                    }
                                    if(row.Tipo === "Dialogo") {
                                        roleplayScenarios[id].levels[lvlIndex].introDialogues.push({ speaker: row.Chi_Parla_o_Agisce, text: row.Testo });
                                    } else if(row.Tipo === "Azione") {
                                        roleplayScenarios[id].levels[lvlIndex].actions.push({ actor: row.Chi_Parla_o_Agisce, text: row.Testo, category: row.Categoria });
                                    }
                                });
                                buildScenarioMenu();
                            }
                        });
                    } else {
                        roleplayScenarios = localDatabaseScenarios; buildScenarioMenu();
                    }
                },
                error: function() {
                    roleplayScenarios = localDatabaseScenarios; buildScenarioMenu();
                }
            });
        }

        function buildScenarioMenu() {
            const container = document.getElementById('scenario-list-container');
            container.innerHTML = '';
            
            const grouped = {};
            Object.keys(roleplayScenarios).forEach(key => {
                const sc = roleplayScenarios[key];
                const ctx = sc.context || "Altro";
                if(!grouped[ctx]) grouped[ctx] = [];
                grouped[ctx].push({ id: key, title: sc.title });
            });

            Object.keys(grouped).forEach(contextName => {
                const titleDiv = document.createElement('div');
                titleDiv.className = 'checklist-title';
                titleDiv.style.cssText = 'color: #fff; border-bottom: 1px solid #444; width: 100%; max-width: 320px; margin-top: 15px; text-transform: uppercase; font-size: 0.95rem; text-align: left; padding-bottom: 4px;';
                titleDiv.innerText = contextName;
                container.appendChild(titleDiv);

                grouped[contextName].forEach(sc => {
                    const btn = document.createElement('button');
                    btn.className = 'btn btn-context';
                    btn.style.cssText = 'width: 320px; padding: 12px; margin: 4px 0; font-size: 1rem;';
                    btn.innerText = sc.title;
                    btn.onclick = () => selectScenario(sc.id);
                    container.appendChild(btn);
                });
            });

            document.getElementById('loader-screen').classList.remove('active');
            document.getElementById('loader-screen').style.display = 'none';
        }

        // NAVIGATION LOGIC (INDIETRO)
        function goBackTo(targetScreenId) {
            const screens = ['selection-screen', 'scenario-screen', 'customize-screen', 'briefing-screen', 'vn-screen', 'minigame-screen', 'cards-screen'];
            screens.forEach(id => {
                const el = document.getElementById(id);
                if(el) {
                    el.classList.remove('active');
                    el.style.display = 'none';
                }
            });
            const target = document.getElementById(targetScreenId);
            if(target) {
                target.style.display = 'flex';
                target.classList.add('active');
            }
        }

        function selectPlayer(name) { 
            currentPlayer = name; 
            goBackTo('scenario-screen');
        }
        
        function selectScenario(scenarioId) {
            currentScenarioId = scenarioId; 
            goBackTo('customize-screen');
            
            const list = document.getElementById('category-list'); 
            list.innerHTML = '';
            const allCategories = new Set();
            
            roleplayScenarios[currentScenarioId].levels.forEach(lvl => {
                if(lvl.actions) {
                    lvl.actions.forEach(act => { 
                        if(act.category && act.category.trim() !== "") {
                            allCategories.add(act.category.trim()); 
                        }
                    });
                }
            });

            if(allCategories.size === 0) {
                allCategories.add("Generale");
            }

            allCategories.forEach(cat => {
                const div = document.createElement('div'); 
                div.className = 'check-item active'; 
                div.style.flex = "1 1 calc(50% - 10px)"; 
                div.style.justifyContent = "center";
                div.innerText = cat; 
                div.onclick = () => div.classList.toggle('active'); 
                div.dataset.category = cat; 
                list.appendChild(div);
            });
        }

