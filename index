        // ENGINE NARRATIVO E MINIGIOCHI
        function loadLevelNarrative() {
            const levelData = roleplayScenarios[currentScenarioId].levels[currentLevelIndex];
            document.getElementById('level-indicator').innerText = `Livello Intensità: ${levelData.level}`;
            
            if (levelData.background && levelData.background.startsWith("http")) {
                document.getElementById('vn-screen').style.backgroundImage = `url('${levelData.background}')`;
            } else {
                document.getElementById('vn-screen').style.backgroundImage = 'none';
                document.getElementById('vn-screen').style.backgroundColor = levelData.background || "#000";
            }
            
            document.getElementById('choices-container').innerHTML = ""; 
            document.getElementById('dialogue-box').style.display = "block";
            currentDialogueIndex = 0; showDialogue();
        }

        function showDialogue() {
            const levelData = roleplayScenarios[currentScenarioId].levels[currentLevelIndex];
            if (currentDialogueIndex < levelData.introDialogues.length) {
                const line = levelData.introDialogues[currentDialogueIndex];
                document.getElementById('speaker-name').innerText = line.speaker;
                document.getElementById('dialogue-text').innerText = line.text;
                
                let color = "var(--primary-accent)"; 
                if (line.speaker === roleplayScenarios[currentScenarioId].roles["Tiziano"] || line.speaker === "Tiziano") color = "var(--secondary-accent)";
                if (line.speaker === "Narratore") color = "#a996b8";
                document.getElementById('speaker-name').style.color = color;
            } else {
                document.getElementById('dialogue-box').style.display = "none";
                document.getElementById('choices-container').innerHTML = `<button class='choice-btn' onclick='openMinigame()'>Gira la Ruota dell'Azione 🎡</button>`;
            }
        }
        function nextDialogue() { currentDialogueIndex++; showDialogue(); }

